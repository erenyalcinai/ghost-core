// Ghost Kokpit — sırlar (ŞABLON). Kopyala: cp Secrets.xcconfig.example Secrets.xcconfig
// Secrets.xcconfig .gitignore'dadır; bu şablon commit'lenir.
// xcconfig'te `//` yorum başlatır — URL'deki çift bölüyü $() ile kır.
GHOST_API_BASE = https:/$()/ghost-api.example.com
GHOST_DEVICE_ID =
GHOST_DEVICE_KEY =
