[Unit]
Description=Ghost onay servisi (onay kaydi + Kokpit cihaz anahtarlari, ayri kullanici)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghost-onay
Group=ghost-onay
ExecStart=/usr/bin/python3 -I /usr/local/lib/ghost-onay/onay_servisi.py
Restart=always
RestartSec=2
RuntimeDirectory=ghost-onay
RuntimeDirectoryMode=0755
StateDirectory=ghost-onay
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
